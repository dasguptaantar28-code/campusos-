# ==============================================================================
# CampusOS — Environment Configuration Template
# Never commit real credentials or private keys to version control.
# Copy to apps/web/.env.local for local Next.js development and configure
# Supabase Edge Function secrets separately via `supabase secrets set`.
# ==============================================================================

# --- Public Client Variables (Safe for Next.js Browser & Flutter Client) -------
NEXT_PUBLIC_APP_NAME=CampusOS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Server-Only Variables (NEVER prefix with NEXT_PUBLIC_ or bundle in APK) --
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_CLI_PAT

# --- Firebase Cloud Messaging (Server-Side Push Dispatch Only) ----------------
# JSON string or Base64-encoded Google Service Account JSON for FCM HTTP v1 API
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Payment Gateway Integration (Server-Side & Webhook Verification) ---------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Optional Security & Rate Limiting ----------------------------------------
CAMPUSOS_RATE_LIMIT_RPM=120
CAMPUSOS_ENABLE_DEMO_SEED=false
